# Copy to .env (gitignored). Secrets stay out of git.
# LLM and embeddings are separate external HTTP services — not in the pod.

# required for `cashflow-audit serve`
REDIS_URL=redis://127.0.0.1:6379/0

# optional; omit URLs to run templates + glossary only
# OpenAI-compatible HTTP only: {base}/chat/completions, {base}/embeddings, {base}/models
# Native LM Studio /api/v1 is rewritten to /v1. Bare host:1234 gets /v1.
# CLI on the host: http://127.0.0.1:1234/v1
# In Docker, 127.0.0.1/localhost become host.docker.internal (compose extra_hosts).
# keys optional — local servers often need none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.6-27b-fp8

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

DATA_DIR=data
WORKER_CONCURRENCY=4
MAX_INFLIGHT=4
MAX_LLM_INFLIGHT=1
MAX_EMBED_INFLIGHT=4
LLM_SLOT_WAIT_SEC=120
JOB_TIMEOUT_SEC=3600
AUDIT_TTL_DAYS=14
JOB_LLM_BUDGET=20
JOB_EMBED_BUDGET=4

LOG_LEVEL=INFO
LOG_JSON=true
